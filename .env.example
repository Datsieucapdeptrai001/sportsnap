BASE_DIR=.
MODEL_PATH=backend/models/best_model.keras
LABELS_PATH=backend/models/labels.json
PREPROCESS=mobilenet_v2
CONFIDENCE_THRESHOLD=0.60
MAX_UPLOAD_MB=12
MAX_BULK_FILES=2000
BULK_BATCH_SIZE=32
BULK_TTL_SECONDS=1800
BULK_MAX_ACTIVE_JOBS=2
BULK_CLEANUP_INTERVAL_SECONDS=60
BULK_TEMP_DIR=backend/tmp/bulk
FRONTEND_DIST=frontend/dist
# Development only: save original /api/scan uploads for inspection.
DEBUG_SAVE_FRAMES=0
DEBUG_FRAMES_DIR=backend/debug_frames
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
