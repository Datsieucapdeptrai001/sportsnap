BASE_DIR=.
# Model and labels are committed unchanged; paths are relative to BASE_DIR.
MODEL_PATH=backend/models/best_model.keras
LABELS_PATH=backend/models/labels.json
PREPROCESS=mobilenet_v2
CONFIDENCE_THRESHOLD=0.60
MAX_UPLOAD_MB=12
MAX_BULK_FILES=2000
BULK_BATCH_SIZE=32
BULK_TTL_SECONDS=1800
BULK_MAX_ACTIVE_JOBS=2
BULK_CLEANUP_INTERVAL_SECONDS=60
BULK_TEMP_DIR=backend/tmp/bulk
# Docker Compose only: Bulk tmpfs capacity; consumes host memory as files grow.
# Increase for large jobs only when the host has enough memory.
BULK_TMPFS_SIZE=2g
BULK_RESULTS_PAGE_SIZE=24
BULK_RESULTS_MAX_LIMIT=100
BULK_THUMB_MAX_SIDE=256
BULK_IMAGE_MAX_SIDE=2048
BULK_PREVIEW_JPEG_QUALITY=85
FRONTEND_DIST=frontend/dist
EXPERIMENTS_PATH=backend/data/experiments.json
INSIGHTS_DIR=backend/data/insights
# Development only: save original /api/scan uploads for inspection.
DEBUG_SAVE_FRAMES=0
DEBUG_FRAMES_DIR=backend/debug_frames
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
